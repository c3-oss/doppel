{
  "name": "@c3-oss/doppel-workspace",
  "version": "0.0.0",
  "description": "Doppel monorepo for a server-first TypeScript product with CLI and web clients.",
  "author": "Caian Ertl <hi@caian.org>",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/c3-oss/doppel#readme",
  "bugs": {
    "url": "https://github.com/c3-oss/doppel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/doppel.git"
  },
  "packageManager": "pnpm@10.8.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "pnpm --filter @c3-oss/doppel-core build && pnpm --filter @c3-oss/doppel-server build && pnpm --filter @c3-oss/doppel build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "biome format --write .",
    "clean": "turbo clean && rm -rf node_modules .turbo coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky",
    "commit": "cz",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:opt": "ncu --upgrade --dep optional --target minor",
    "bump:all": "pnpm bump:opt && pnpm bump:dev && pnpm bump:prod",
    "lint:fix-unsafe": "turbo lint:fix-unsafe"
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@c3-oss/config-biome": "^0.3.1",
    "@c3-oss/config-typescript": "^0.1.0",
    "@c3-oss/fim": "^0.1.0",
    "@changesets/cli": "^2.29.7",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/cz-commitlint": "^19.8.1",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.13.5",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-react": "^4.4.1",
    "@vitest/coverage-v8": "^3.2.4",
    "commitizen": "^4.3.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "npm-check-updates": "^17.1.18",
    "tsup": "^8.5.0",
    "turbo": "^2.5.6",
    "typedoc": "^0.28.19",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-rename-defaults": "^0.7.3",
    "typescript": "^5.9.2",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
