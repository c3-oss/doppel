{
  "name": "@c3-oss/doppel-server",
  "version": "0.1.2",
  "description": "Doppel HTTP and tRPC server.",
  "author": "Caian Ertl <hi@caian.org>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/c3-oss/doppel#readme",
  "bugs": {
    "url": "https://github.com/c3-oss/doppel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/doppel.git",
    "directory": "apps/server"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "doppel-server": "./dist/bin/server.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/bin/server.ts",
    "build": "pnpm --filter @c3-oss/doppel-web build && tsup && rm -rf dist/web && cp -R ../web/dist dist/web",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "pnpm bump:dev && pnpm bump:prod",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@c3-oss/doppel-core": "workspace:^",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.1.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.3.0",
    "@trpc/server": "^11.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "commander": "^12.1.0",
    "fastify": "^5.11.0",
    "pino-pretty": "^13.1.3",
    "superjson": "^2.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "^0.3.1",
    "@c3-oss/config-tsup": "^0.2.1",
    "@c3-oss/config-typescript": "^0.1.0",
    "@c3-oss/config-vitest": "^0.3.1"
  }
}
