{
  "name": "@c3-oss/doppel-web",
  "version": "0.1.0",
  "description": "Doppel web client.",
  "author": "Caian Ertl <hi@caian.org>",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "typedocOptions": {
    "tsconfig": "./src/tsconfig.typedoc.json"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "pnpm bump:dev && pnpm bump:prod",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "@c3-oss/doppel-server": "workspace:^",
    "@tanstack/react-query": "^5.101.4",
    "@trpc/client": "^11.18.0",
    "@trpc/react-query": "^11.18.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "lucide-react": "^1.28.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "superjson": "^2.2.1"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "^0.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "vite-tsconfig-paths": "^5.1.4"
  }
}
