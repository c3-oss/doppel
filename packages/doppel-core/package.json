{
  "name": "@c3-oss/doppel-core",
  "version": "0.1.1",
  "description": "Doppel core engine: terminal sessions, schedules, and persistence.",
  "author": "Caian Ertl <hi@caian.org>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/c3-oss/doppel#readme",
  "bugs": {
    "url": "https://github.com/c3-oss/doppel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/doppel.git",
    "directory": "packages/doppel-core"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "lint:fix-unsafe": "biome check --fix --unsafe .",
    "bump:dev": "ncu --upgrade --dep dev --target minor",
    "bump:prod": "ncu --upgrade --dep prod --target minor",
    "bump:all": "pnpm bump:dev && pnpm bump:prod",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.2",
    "node-cron": "^4.6.0",
    "node-pty": "1.2.0-beta.12",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@c3-oss/config-biome": "^0.3.1",
    "@c3-oss/config-tsup": "^0.2.1",
    "@c3-oss/config-typescript": "^0.1.0",
    "@c3-oss/config-vitest": "^0.3.1",
    "@types/better-sqlite3": "^7.6.13"
  }
}
