{
  "name": "@c3-oss/doppel",
  "version": "0.1.0",
  "description": "Doppel command line client.",
  "author": "Caian Ertl <hi@caian.org>",
  "license": "MIT",
  "type": "module",
  "homepage": "https://github.com/c3-oss/doppel#readme",
  "bugs": {
    "url": "https://github.com/c3-oss/doppel/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/c3-oss/doppel.git",
    "directory": "packages/cli"
  },
  "files": ["dist"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "doppel": "./dist/bin/doppel.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/bin/doppel.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "clean": "rm -rf dist coverage .turbo"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "zod": "^3.25.76"
  }
}
